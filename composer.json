{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "alatkopimalang/akm-store",
    "type": "project",
    "description": "Alat Kopi Malang curated coffee equipment and barista tools web application.",
    "keywords": ["laravel", "filament", "inertia", "react", "coffee-gear"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "crumbls/layup": "^1.7",
        "filament/filament": "^5.10",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/octane": "^2.22",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "mallardduck/blade-lucide-icons": "^2.0",
        "wallacemartinss/filament-icon-picker": "^2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "config": {
        "platform-check": false,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

